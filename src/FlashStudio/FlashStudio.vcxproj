      <_WindowsAppSdkInitializer Include="@(ClCompile->WithMetadataValue('Filename', 'WindowsAppRuntimeAutoInitializer')->Distinct())" />
      <ClCompile Remove="@(_WindowsAppSdkInitializer)" />
      <ClCompile Include="@(_WindowsAppSdkInitializer)" />
    </ItemGroup>
  </Target>
